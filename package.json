{
  "name": "dsh-checkpoint-memory",
  "version": "0.2.1",
  "description": "Curated file-based long-term memory for DeepSeek Harness — human-readable markdown notes, one plain-file store shared across hosts (git-ignored when it lives inside a project repo), and a deterministic index cap enforced by ctx.tools.guard()",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "memory",
    "agent-memory",
    "long-term-memory",
    "markdown"
  ],
  "type": "module",
  "main": "index.js",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    },
    "compatibility": {
      "dsh": ">=0.1.0-rc.7 <0.2.0-0",
      "dshReleases": {
        "0.1.5-rc.3": "compatible",
        "0.1.7-alpha.1": "compatible",
        "0.1.7-alpha.2": "compatible",
        "0.1.7-rc.1": "compatible"
      }
    }
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "install-skill.js",
    "client.js",
    "skill/",
    "cordis.patch.yml",
    "UPSTREAM.md",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gege9527/dsh-checkpoint-memory.git"
  },
  "homepage": "https://github.com/gege9527/dsh-checkpoint-memory#readme",
  "bugs": {
    "url": "https://github.com/gege9527/dsh-checkpoint-memory/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  }
}
